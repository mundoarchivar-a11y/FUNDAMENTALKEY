# Macro Alignment Engine — Frontend (.env)
# Copia este archivo como .env y rellena tus credenciales de Supabase.
# Las variables VITE_ son expuestas al browser — usa la ANON key (nunca la service_role key).

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
